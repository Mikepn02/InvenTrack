<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="order_history_report" pageWidth="595" pageHeight="842" columnWidth="515">
    <field name="orderId" class="java.lang.Integer"/>
    <field name="orderDate" class="java.time.LocalDate"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="supplierName" class="java.lang.String"/>
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement>
                    <font size="18"/>
                </textElement>
                <text><![CDATA[Order History Report]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="100" height="20"/>
                <text><![CDATA[Order ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="150" height="20"/>
                <text><![CDATA[Order Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="0" width="150" height="20"/>
                <text><![CDATA[Total Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="115" height="20"/>
                <text><![CDATA[Supplier]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{orderId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{orderDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="115" height="20"/>
                <textFieldExpression><![CDATA[$F{supplierName}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
